generator client {
  provider   = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                            Int                 @id @default(autoincrement())
  username                      String              @unique
  email                         String              @unique
  password_hash                 String
  nationality                   String?
  firstname                     String?
  lastname                      String?
  avatar                        String?
  userKarma                     Int                 @default(0)
  relationship                  RelationshipStatus?
  description                   String?
  work                          WorkStatus?
  active                        Boolean             @default(true)
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  comments                      Comment[]           @relation("UserComments")
  ownedFeeds                    Feed[]              @relation("FeedOwner")
  messages                      Message[]
  posts                         Post[]              @relation("UserPosts")
  ownedRooms                    Room[]              @relation("RoomOwner")
  bannedFromFeeds               Feed[]              @relation("FeedBannedUsers")
  moderatedFeeds                Feed[]              @relation("FeedModerators")
  chatroomInvites               Room[]              @relation("UserChatroomInvites")
  chatrooms                     Room[]              @relation("UserChatrooms")
  dislikedComments              Comment[]           @relation("UserDislikedComments")
  dislikedPosts                 Post[]              @relation("UserDislikedPosts")
  feedSubs                      Feed[]              @relation("UserFeedSubs")
  User_UserFriendRequests_A     User[]              @relation("UserFriendRequests")
  User_UserFriendRequests_B     User[]              @relation("UserFriendRequests")
  User_UserFriendRequestsSent_A User[]              @relation("UserFriendRequestsSent")
  User_UserFriendRequestsSent_B User[]              @relation("UserFriendRequestsSent")
  User_UserFriends_A            User[]              @relation("UserFriends")
  User_UserFriends_B            User[]              @relation("UserFriends")
  likedComments                 Comment[]           @relation("UserLikedComments")
  likedPosts                    Post[]              @relation("UserLikedPosts")
}

model Post {
  id            Int       @id @default(autoincrement())
  headline      String?
  description   String?
  karma         Int       @default(0)
  commentsCount Int       @default(0)
  img           String?
  locked        Boolean   @default(false)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  ownerId       Int?
  feedId        Int?
  comments      Comment[] @relation("PostComments")
  feed          Feed?     @relation("FeedPosts", fields: [feedId], references: [id])
  owner         User?     @relation("UserPosts", fields: [ownerId], references: [id])
  dislikedBy    User[]    @relation("UserDislikedPosts")
  likedBy       User[]    @relation("UserLikedPosts")
}

model Feed {
  id          Int      @id @default(autoincrement())
  feedname    String   @unique
  description String
  feedavatar  String?
  subsCount   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  ownerId     Int?
  chatRoomId  Int?     @unique
  chatRoom    Room?    @relation("FeedChatRoom", fields: [chatRoomId], references: [id])
  owner       User?    @relation("FeedOwner", fields: [ownerId], references: [id])
  posts       Post[]   @relation("FeedPosts")
  bannedusers User[]   @relation("FeedBannedUsers")
  moderators  User[]   @relation("FeedModerators")
  subs        User[]   @relation("UserFeedSubs")
}

model Comment {
  id         Int       @id @default(autoincrement())
  content    String?
  karma      Int       @default(0)
  depth      Int       @default(0)
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  postId     Int?
  userId     Int?
  replyToId  Int?
  post       Post?     @relation("PostComments", fields: [postId], references: [id])
  replyto    Comment?  @relation("CommentReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies    Comment[] @relation("CommentReplies")
  user       User?     @relation("UserComments", fields: [userId], references: [id])
  dislikedBy User[]    @relation("UserDislikedComments")
  likedBy    User[]    @relation("UserLikedComments")
}

model Room {
  id           Int       @id @default(autoincrement())
  name         String
  type         RoomType?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  ownerId      Int?
  feed         Feed?     @relation("FeedChatRoom")
  messages     Message[]
  owner        User?     @relation("RoomOwner", fields: [ownerId], references: [id])
  invitedUsers User[]    @relation("UserChatroomInvites")
  users        User[]    @relation("UserChatrooms")
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  Int
  roomId    Int
  author    User     @relation(fields: [authorId], references: [id])
  room      Room     @relation(fields: [roomId], references: [id])
}

enum RelationshipStatus {
  Single
  Married
  Dating
  Other
}

enum WorkStatus {
  Working
  Unemployed
  Retired
}

enum RoomType {
  GROUP
  FEED
  PRIVATE
}
